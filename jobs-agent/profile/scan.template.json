{
  "_comment": "JobsPipe radar. Every job returned costs one credit (free tier: 1,000 once). Keep queries narrow: the scan is a radar for companies worth a warm approach, not a cold-application funnel. Field names verified against jobspipe-go and jobspipe-cli on 2026-10-15. RSS feeds are read as published; Duunitori and LinkedIn are not scraped (their terms forbid it): LinkedIn public postings arrive through JobsPipe, and Duunitori finds go in by hand with /score <url>.",
  "page_size": 50,
  "max_results_per_query": 100,
  "queries": [
    {
      "name": "finland-product-leadership",
      "filters": {
        "job_title_or": [
          "head of product",
          "director of product",
          "product director",
          "vp product",
          "vp of product",
          "chief product officer",
          "cpo",
          "head of product management",
          "director, product",
          "tuotejohtaja"
        ],
        "job_country_code_or": [
          "FI"
        ],
        "posted_at_max_age_days": 14
      }
    },
    {
      "name": "remote-nordics-baltics-product-leadership",
      "filters": {
        "job_title_or": [
          "head of product",
          "director of product",
          "product director",
          "vp product",
          "vp of product",
          "chief product officer",
          "head of product management"
        ],
        "job_country_code_or": [
          "EE",
          "SE",
          "DK",
          "NO"
        ],
        "remote": true,
        "posted_at_max_age_days": 14
      }
    }
  ],
  "title_must_match_any": [
    "head of product",
    "director",
    "vp",
    "vice president",
    "chief product",
    "cpo",
    "product lead",
    "tuotejohtaja",
    "group product"
  ],
  "title_exclude_any": [
    "intern",
    "junior",
    "associate",
    "product owner",
    "marketing",
    "sales",
    "engineering manager",
    "software engineer",
    "designer"
  ],
  "avoid_keywords": [
    "payroll",
    "accounts payable",
    "invoicing",
    "financial close",
    "accounting software",
    "bookkeeping",
    "defence",
    "defense",
    "government procurement",
    "tender",
    "workforce management",
    "hr tech",
    "adtech",
    "product coach",
    "chief of staff",
    "safe agile",
    "scaled agile"
  ],
  "_comment_avoid_companies": "Companies dropped at scan on evidence about how they treat the role (for example, repeated reports of leadership churn from people you trust), not on their postings. Give each a reason.",
  "avoid_companies": [],
  "rss_feeds": [
    {
      "name": "vierityspalkki",
      "url": "https://vierityspalkki.fi/tyopaikat/feed/",
      "country": "FI",
      "company_pattern": "^\\s*(.+?)\\s+(?:etsii|hakee|is looking|is hiring|seeks)\\b"
    }
  ],
  "_comment_watchlist": "Company watchlist: each company's public job-board endpoint (free, no credits). ats is one of greenhouse, lever (add \"eu\": true for api.eu.lever.co), ashby, recruitee, personio, teamtailor (give \"url\" ending in /jobs.rss for custom domains). Find the slug where the company's 'apply' links point. search_firm: true means a recruiter's board; the client company is taken from the title with title_company_pattern. Replace the examples and set enabled to true.",
  "watchlist_title_must_match_any": [
    "product"
  ],
  "watchlist_title_exclude_any": [
    "designer",
    "design engineer",
    "engineer",
    "marketing",
    "analyst",
    "intern",
    "junior",
    "associate",
    "owner",
    "quality",
    "cost",
    "specialist"
  ],
  "watchlist": [
    {
      "company": "<Company name>",
      "ats": "greenhouse",
      "slug": "<board-slug>",
      "enabled": false
    },
    {
      "company": "<Search firm name>",
      "ats": "teamtailor",
      "url": "https://<their-careers-domain>/jobs.rss",
      "search_firm": true,
      "title_company_pattern": "^(.+?)\\s+-\\s+(?=\\S)",
      "enabled": false
    }
  ]
}
